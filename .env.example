PORT=3000
HOST=0.0.0.0

# Optional. Without it: numeric ids = TMDB, tt… ids = IMDb, and providers that
# need the other kind are reported unavailable instead of failing silently.
# With it: IMDb<->TMDB conversion + titles, posters, season/episode counts.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# How long /api/sources results are cached (ms), and extra providers (JSON, see src/providers.js)
SOURCES_CACHE_TTL_MS=600000
# EXTRA_PROVIDERS=[{"id":"mine","name":"Mine","idTypes":["tmdb"],"prefer":"tmdb","movie":"https://example.com/movie/{tmdb}","tv":"https://example.com/tv/{tmdb}/{s}/{e}"}]
